# Copy to .env.local. Never commit real values.

# --- Required ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SITE_URL=https://gtsmt.com

# --- Enquiry spam protection: Cloudflare Turnstile ---
# Both are required in production: without the secret, enquiries are refused rather than accepted unchecked.
# Leave both empty in local development to skip the check (the form still works).
# To exercise the real check locally, Cloudflare publishes test keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/). Never use these in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Enquiry email ---
# Without RESEND_API_KEY, notification emails are only written to the server log and each enquiry shows
# "No email provider is configured" in the admin. The sending domain needs SPF and DKIM set up with the provider.
# Who receives notifications is set in the admin under Website Settings > Enquiries.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=enquiries@gtsmt.com
# EMAIL_FROM_NAME=GTSMT
