{
  "name": "gtsmt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:start": "pg_ctl -D .local/pgdata -l .local/pg.log -w start",
    "db:stop": "pg_ctl -D .local/pgdata stop",
    "seed:structure": "payload run scripts/seed-structure.ts",
    "seed:samples": "payload run scripts/seed-samples.ts",
    "seed:samples:remove": "payload run scripts/seed-samples.ts -- --remove",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "search:reindex": "payload run scripts/search-reindex.ts",
    "test:cleanup": "payload run scripts/cleanup-test-enquiries.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "enquiries:purge": "payload run scripts/purge-enquiries.ts",
    "test:users": "payload run scripts/e2e-users.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/manrope": "^5.2.5",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "^3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
